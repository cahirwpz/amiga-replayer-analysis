MACHINE 68000
OFFSET $00000000
ENTRY $00000000
CODE $00000000 - $00000028
CODE $0000002C - $0000033E
LABEL SaveVector $00000014
LABEL RestoreVector $0000001E
LABEL SavedVector $00000028
LABEL InitSong $0000002C
LABEL NullInterrupt $000000E2
LABEL StopSound $000000E4
LABEL Play $000000FE
LABEL PeriodTable $000003DC
LABEL Songs $000006AE
END
