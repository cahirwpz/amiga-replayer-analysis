#!/bin/bash
# This file must be used with "source ./activate" in the repository root.

function replayer_analysis_activate {
  git submodule update --init || return 1
  python3 -m venv .venv || return 1
  # shellcheck source=/dev/null
  source .venv/bin/activate || return 1
  python3 -m pip -q install -U -r requirements.txt || return 1
  # Built once from the current Aminet release; delete it to update.
  if ! [ -x .venv/bin/ira ]; then
    python3 tools/disasm.py install || return 1
  fi
  # CI runs the hooks directly; a git hook there would be pointless.
  if [[ "$GITHUB_ACTIONS" != "true" ]]; then
    pre-commit install || return 1
  fi
}

# The venv and requirements.txt resolve against $(pwd).
# zsh names the sourced file in $0 at top level; bash in BASH_SOURCE.
if ! [ "${BASH_SOURCE[0]:-$0}" -ef ./activate ]; then
  REPLAYER_ANALYSIS_TOP=$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)
  echo "activate: must be sourced from ${REPLAYER_ANALYSIS_TOP}, not $(pwd)"
  echo "  cd ${REPLAYER_ANALYSIS_TOP} && source ./activate"
  unset REPLAYER_ANALYSIS_TOP
  return 1
fi

if ! replayer_analysis_activate; then
  echo "amiga-replayer-analysis environment setup failed!"
  return 1
fi

echo "amiga-replayer-analysis environment in $(pwd) configured!"
